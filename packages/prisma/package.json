{
  "name": "prisma",
  "version": "8.0.0-rc.8",
  "description": "The Prisma CLI: one binary for the ORM, Composer, and the Prisma Developer Platform.",
  "type": "module",
  "bin": {
    "prisma": "./dist/prisma.js"
  },
  "exports": {
    "./package.json": "./package.json",
    "./config": {
      "types": "./dist/config.d.ts",
      "import": "./dist/config.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "keywords": [
    "prisma",
    "cli",
    "orm",
    "database",
    "deployment"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/prisma/prisma-cli.git",
    "directory": "packages/prisma"
  },
  "homepage": "https://github.com/prisma/prisma-cli#readme",
  "bugs": {
    "url": "https://github.com/prisma/prisma-cli/issues"
  },
  "license": "Apache-2.0",
  "scripts": {
    "build": "tsdown",
    "prepack": "pnpm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@manypkg/tools": "^2.1.2",
    "@prisma/cli-engine": "workspace:0.2.1",
    "@prisma/composer-cli": "0.12.0",
    "@prisma/compute-sdk": "0.39.0",
    "@prisma/credentials-store": "^7.8.0",
    "@prisma/management-api-sdk": "1.55.0",
    "@prisma/orm-toolchain": "8.0.0-rc.5",
    "@vercel/detect-agent": "^1.2.3",
    "better-result": "^2.9.2",
    "dotenv": "^17.4.2",
    "execa": "^9.6.1",
    "open": "^11.0.0"
  },
  "devDependencies": {
    "@prisma/cli": "workspace:8.0.0-rc.8",
    "@repo/cli-telemetry": "workspace:8.0.0-rc.8",
    "@repo/tsconfig": "workspace:8.0.0-rc.8",
    "@types/node": "^22.19.19",
    "tsdown": "^0.21.10",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
