{
  "name": "@repo/cli-telemetry",
  "private": true,
  "version": "0.0.0",
  "description": "CLI telemetry client: detached subprocess sender, gating resolution, user-config store, and the value-free command sanitizer",
  "type": "module",
  "sideEffects": [
    "./dist/sender.js",
    "./src/sender.ts"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./sender": {
      "types": "./dist/sender.d.ts",
      "import": "./dist/sender.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "license": "Apache-2.0",
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "pnpm run build && pnpm run typecheck && vitest run"
  },
  "dependencies": {
    "@vercel/detect-agent": "^1.2.3",
    "c12": "^3.3.4"
  },
  "devDependencies": {
    "@repo/tsconfig": "workspace:*",
    "@types/node": "^22.19.19",
    "tsdown": "^0.21.10",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
