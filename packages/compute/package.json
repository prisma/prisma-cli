{
  "name": "@prisma/compute",
  "version": "0.1.0-development",
  "description": "Utilities for applications running on the Prisma compute runtime.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "keywords": [
    "prisma",
    "compute",
    "runtime"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/prisma/prisma-cli.git",
    "directory": "packages/compute"
  },
  "homepage": "https://github.com/prisma/prisma-cli#readme",
  "bugs": {
    "url": "https://github.com/prisma/prisma-cli/issues"
  },
  "license": "Apache-2.0",
  "scripts": {
    "build": "tsdown",
    "prepack": "pnpm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^22.19.19",
    "tsdown": "^0.21.10",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
