{
  "name": "@repo/cli-conformance",
  "private": true,
  "version": "8.0.0-rc.2",
  "description": "Reusable conformance checks for the engine's consumers: import purity over built output, config-section validators that never throw, and verification of the tarballs a registry would receive. Depends on no package it checks.",
  "type": "module",
  "exports": {
    "./module-graph": "./src/module-graph.ts",
    "./import-purity": "./src/checks/import-purity.ts",
    "./validator-no-throw": "./src/checks/validator-no-throw.ts",
    "./subjects": "./src/subjects.ts",
    "./findings": "./src/findings.ts",
    "./package.json": "./package.json",
    "./tarball": "./src/checks/tarball.ts",
    "./tarball-io": "./src/tarball-io.ts"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "license": "Apache-2.0",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "pnpm run typecheck && vitest run"
  },
  "devDependencies": {
    "@repo/tsconfig": "workspace:8.0.0-rc.2",
    "@types/node": "^22.19.19",
    "es-module-lexer": "^2.1.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
