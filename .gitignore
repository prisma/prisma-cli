# Dependencies
node_modules/

# Local CLI state
.prisma/
packages/*/.prisma/
/prisma.config.ts
tmp/

# Build and test output
artifacts/
dist/
.publish/
coverage/
.vitest/
*.tsbuildinfo

# Logs
*.log
pnpm-debug.log*
npm-debug.log*

# Environment files
.env
.env.local
.env.*.local

# Editor and OS files
.DS_Store
.idea/
.vscode/

# Turborepo cache
.turbo/

# Review artifacts — never committed
.drive/projects/prisma-cli-v8/reviews/
.drive/projects/prisma-cli-v8/specs/reviews/
wip/

# Reference clones of other repos, read while working. Ignored here rather
# than in .git/info/exclude because biome reads .gitignore, and a clone
# carrying its own root config fails `pnpm lint` before it lints anything.
.reference/
