{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": [
        "src/**",
        "package.json",
        "tsconfig.json",
        "tsdown.config.ts",
        "$TURBO_ROOT$/packages/tsconfig/base.json"
      ],
      "outputs": ["dist/**"]
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": [
        "src/**",
        "tests/**",
        "fixtures/**",
        "package.json",
        "tsconfig.json",
        "tsdown.config.ts",
        "vitest.config.ts",
        "$TURBO_ROOT$/packages/tsconfig/base.json"
      ]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "inputs": [
        "src/**",
        "tests/**",
        "package.json",
        "tsconfig.json",
        "$TURBO_ROOT$/packages/tsconfig/base.json"
      ]
    }
  }
}
